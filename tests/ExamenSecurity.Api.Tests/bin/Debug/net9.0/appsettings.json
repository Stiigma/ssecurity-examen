{
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Database=ExamenSecurityDb;Username=postgres;Password=Your_strong_password123;Port=5432"
  },
  "Jwt": {
    "Issuer": "ExamenSecurity.Api",
    "Audience": "ExamenSecurity.Client",
    "SigningKey": "LOCAL_DEMO_ONLY_CHANGE_ME_32_CHARS_MIN",
    "ExpirationMinutes": 90
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "WhitelistedIps": [
      "127.0.0.1",
      "::1"
    ],
    "ExcludedPaths": [
      "/api/demo/health"
    ],
    "Auth": {
      "MaxRequests": 5,
      "WindowSeconds": 60
    },
    "Admin": {
      "MaxRequests": 20,
      "WindowSeconds": 60
    },
    "General": {
      "MaxRequests": 100,
      "WindowSeconds": 60
    }
  },
  "AccountLockout": {
    "Enabled": true,
    "BaseDurationMinutes": 15,
    "MaxFailedAttemptsBeforeLockout": 5,
    "LockIpAddress": true,
    "LockUserAccount": true
  },
  "LogIntegrity": {
    "Enabled": true,
    "HmacSecretKey": "CHANGE_ME_IN_PRODUCTION_32_CHARS_MINIMUM_64_PREFERRED"
  },
  "SecurityLogForwarding": {
    "Enabled": true,
    "File": {
      "Enabled": true,
      "Path": "logs/security-events.jsonl",
      "MaxFileSizeMb": 10,
      "RetainFiles": 30
    },
    "Stdout": {
      "Enabled": true
    }
  },
  "Honeytoken": {
    "Enabled": true,
    "EnableDelay": true,
    "DelayMinMs": 2000,
    "DelayMaxMs": 5000
  },
  "ImpossibleTravel": {
    "Enabled": true,
    "MaxSpeedKmh": 900,
    "IgnoreLocalIps": true,
    "IgnoredCountryCodes": ["VPN", "TOR"]
  },
  "AllowedHosts": "*"
}
