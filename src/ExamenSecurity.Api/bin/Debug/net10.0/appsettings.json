{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=ExamenSecurityDb;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "ExamenSecurity.Api",
    "Audience": "ExamenSecurity.Client",
    "SigningKey": "LOCAL_DEMO_ONLY_CHANGE_ME_32_CHARS_MIN",
    "ExpirationMinutes": 90
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "WhitelistedIps": [
      "127.0.0.1",
      "::1"
    ],
    "ExcludedPaths": [
      "/api/demo/health"
    ],
    "Auth": {
      "MaxRequests": 5,
      "WindowSeconds": 60
    },
    "Admin": {
      "MaxRequests": 20,
      "WindowSeconds": 60
    },
    "General": {
      "MaxRequests": 100,
      "WindowSeconds": 60
    }
  },
  "AccountLockout": {
    "Enabled": true,
    "BaseDurationMinutes": 15,
    "MaxFailedAttemptsBeforeLockout": 5,
    "LockIpAddress": true,
    "LockUserAccount": true
  },
  "AllowedHosts": "*"
}
